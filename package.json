    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "node-html-parser": "^9.0.6",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.64.1",
    "puppeteer-core": "^25.16.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
