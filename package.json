{
  "name": "auto-apply",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @apply/web dev",
    "dev:worker": "pnpm --filter @apply/worker start",
    "build": "pnpm --filter @apply/web build",
    "db:generate": "pnpm --filter @apply/db generate",
    "db:migrate": "pnpm --filter @apply/db migrate",
    "keys:generate": "pnpm --silent --filter @apply/db keys",
    "demo": "pnpm --filter @apply/worker demo",
    "login": "pnpm --filter @apply/worker login",
    "browsers:install": "playwright-core install chromium",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "playwright-core": "^1.64.1",
    "prettier": "^3.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
