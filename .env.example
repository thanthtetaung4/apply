# Copy to .env (never commit). Copy it to apps/web/.env.local and apps/worker/.env too:
# Next.js and the worker each read the file in their own folder.

DATABASE_URL=postgres://apply:apply@localhost:5432/apply
# Neon: the direct (non-pooled) URL, used by `pnpm db:migrate`.
# DATABASE_URL_UNPOOLED=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# open, invite or closed
REGISTRATION_MODE=open
# INVITE_CODE=

# Model keys, own model servers and the Job Search Board are saved per user on the Connections
# page, not here. Each user picks their AI on Settings: none, App AI, their OpenRouter key, or
# their own server (Ollama).

# --- App AI: your own model, free for a few applications a week, then paid ---
# Worker: the key that pays for App AI. Without it, App AI runs without AI.
# PLATFORM_OPENROUTER_KEY=
# PLATFORM_MODEL=openai/gpt-4o-mini
# Worker AND web app (keep them equal). Weeks start Monday 00:00 UTC.
# FREE_AI_APPLICATIONS_PER_WEEK=5
# Worker: per user daily spend cap on your key (USD).
# PLATFORM_DAILY_BUDGET_USD=0.5
# Web app: show App AI as an option.
# PLATFORM_AI=on

# --- Web app: selling AI applications with Stripe Checkout (one-time payments) ---
# STRIPE_PRICE_ID is a one-time price for one pack. Webhook endpoint: <APP_URL>/api/stripe/webhook
# with the events checkout.session.completed and checkout.session.async_payment_succeeded.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# AI_CREDITS_PER_PACK=50
# APP_URL=https://app.example.com

# --- Self-hosted only: let users' own model servers be on private addresses (192.168.x, localhost)
# Worker and web app. NEVER on a shared, hosted install.
# ALLOW_PRIVATE_LLM_ENDPOINTS=1

# --- Signed in job site sessions (pnpm keys:generate) ---
# Web app and worker. The web app can lock sessions with it, never open them.
SESSION_PUBLIC_KEY=
# Web app: where the user's browser opens sign in windows (the worker). wss:// in production.
# WORKER_SIGNIN_URL=ws://localhost:4100/signin

# --- Worker only ---
# Opens sealed sessions. NEVER give this to the web app. During a key change: new,old
WORKER_SESSION_PRIVATE_KEY=
# Sign in window server.
# LOGIN_PORT=4100
# Web app origins allowed to open sign in windows, comma separated.
# LOGIN_ALLOWED_ORIGINS=http://localhost:3000
# Sign in windows open at once (each is a real browser).
# LOGIN_MAX_SESSIONS=3

# --- Worker only: local model for testing (Ollama, LM Studio, llama.cpp) ---
# Replaces every user's OpenRouter key while set. Without it and without a key, the offline
# stand-in is used (never answers questions).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b
# Tasks allowed to think, comma separated, or "none" for a model without thinking.
# LLM_THINK_TASKS=answer_field
# LLM_TIMEOUT_MS=180000
# Ollama only (detected automatically, then its native API is used): context window per request.
# Ollama's own default (~2048 tokens) silently drops the start of a long job posting.
# LLM_NUM_CTX=8192
